---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/projects", class: customClass, ...props } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 text-primary-100 hover:text-primary-100 bg-darkslate-900 hover:bg-darkslate-800 hover:border-primary-500 w-fit px-4 py-2 border border-darkslate-400 rounded-lg transition-all duration-200 ${customClass ?? ""}`}
  {...props}
>
  ← Back
</a>
